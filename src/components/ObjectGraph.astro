---
/**
 * Vulkan object tree, as a map or as a create/destroy exercise (ObjectGraphView island on the engine's TreeView).
 *   <ObjectGraph />                                          the whole map
 *   <ObjectGraph scope={['instance', 'debug-messenger', ...]} mode="build" />   exercise on a subset
 * objects.json and its translations are validated here (bad data fails the build); texts follow the page's language.
 * Each object hangs off its FIRST parent in objects.json (the one it is made from); further parents (a descriptor set
 * also needs a layout) are dashed wires or "+ from X" notes. Colors = the stage of the object (OBJ_GROUPS order),
 * from the engine palette (STAGE_COLOR).
 */
import ObjectGraphView from './ObjectGraphView.tsx';
import { NOTE_OVERLAYS, OBJECTS, OBJ_GROUPS, labelOf, noteOf, obj, objectErrors, overlayErrors, scopedParents, type Stage } from '../lib/objects';
import { HOW_KEY, STAGE_KEY, courseText } from '../i18n';
import { graphIn } from 'course-kit/lib/terms.ts';
import { tfmt } from '../lib/text';
import { ruleVersion } from '../lib/object-trainer';
// Raw sources of the build exercise's rules (build time only; never reach the browser): their hash is the version
// stored runs are tagged with.
import objectsData from '../data/objects.json?raw';
import objectsCode from '../lib/objects.ts?raw';
import trainerCode from '../lib/object-trainer.ts?raw';
import { DEFAULT_LANG, LANGUAGES, courseIn, langOf } from 'course-kit/lib/course.ts';
import { groupColor, type TreeGroup, type TreeItem } from 'course-kit/components/graph/TreeView.tsx';

interface Props {
	mode?: 'map' | 'build';
	/** Object ids to show (default: all). Parents outside the scope are left out of the picture. */
	scope?: string[];
	caption?: string;
}

const v = courseIn(langOf(Astro.url.pathname));
const t = courseText(v.lang);
// Every course language other than the default needs a complete translation of the object notes.
const missingLangs = LANGUAGES.slice(1).filter((l) => !(l.code in NOTE_OVERLAYS)).map((l) => `objects.${l.code}.json`);
const errs = [...objectErrors(new Set(graphIn(DEFAULT_LANG).terms.map((x) => x.id))), ...overlayErrors(), ...missingLangs.map((f) => `${f} is missing`)];
if (errs.length) throw new Error(`objects data is invalid:\n  - ${errs.join('\n  - ')}`);

const { mode = 'map', caption } = Astro.props;
const scope = Astro.props.scope ?? OBJECTS.map((o) => o.id);
scope.forEach((id) => obj(id));

const items: TreeItem[] = scope.map((id) => {
	const o = obj(id);
	const [first, ...rest] = scopedParents(id, scope);
	return {
		id,
		label: labelOf(o),
		def: noteOf(o, v.lang, DEFAULT_LANG),
		group: o.stage,
		parent: first?.id ?? null,
		extra: rest.map((p) => ({ id: p.id, note: p.optional ? t.optional : p.createOnly ? t.createOnly : undefined })),
		code: true,
		sub: t[HOW_KEY[o.how]],
	};
});
/**
 * Stage -> entry of the engine's group palette (theme.css `--ck-group-N`, 0-based here): nine distinct hues; entry 5
 * (the neutral gray) is skipped so no stage looks disabled. A site theme recolors the stages through the palette.
 */
const STAGE_COLOR: Record<Stage, number> = { instance: 0, devices: 1, memory: 2, pipeline: 3, sync: 4, presentation: 6, images: 7, descriptors: 8, commands: 9 };
const groups: TreeGroup[] = OBJ_GROUPS.map((s) => ({ id: s, label: t[STAGE_KEY[s]], color: groupColor(STAGE_COLOR[s]) }));
const version = ruleVersion([objectsData, objectsCode, trainerCode]);
const termHref = Object.fromEntries(scope.flatMap((id) => (obj(id).term ? [[obj(id).term!, v.resolveLink(`term:${obj(id).term}`)!]] : [])));
---

<figure class="vk-objgraph not-content">
	<ObjectGraphView client:only="react" lang={v.lang} mode={mode} items={items} groups={groups} termHref={termHref} version={version} />
	{caption && <figcaption>{caption}</figcaption>}
	<details class="vk-objgraph-text">
		<summary>{t.asText}</summary>
		<ul>
			{
				scope.map((id) => {
					const o = obj(id);
					return (
						<li>
							<b>{labelOf(o)}</b> — {o.call}
							{o.parents.length > 0 && `, ${tfmt(v.lang, t.madeFrom, { parents: o.parents.map((p) => labelOf(obj(p.id))).join(' + ') })}`}
							{o.destroy && `; ${tfmt(v.lang, t.releasedWith, { call: o.destroy })}`}. {noteOf(o, v.lang, DEFAULT_LANG)}
						</li>
					);
				})
			}
		</ul>
	</details>
</figure>

<style>
	.vk-objgraph {
		margin: 1.5rem 0;
		min-height: 10rem;
	}
	figcaption,
	.vk-objgraph-text summary {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.vk-objgraph-text {
		font-size: var(--sl-text-sm);
	}
	.vk-objgraph-text summary {
		cursor: pointer;
	}
</style>
