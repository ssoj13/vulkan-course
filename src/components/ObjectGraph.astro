---
/**
 * Vulkan object tree, as a map or as a create/destroy exercise (ObjectGraphView island).
 *   <ObjectGraph />                                          the whole map
 *   <ObjectGraph scope={['instance', 'debug-messenger', ...]} mode="build" />   exercise on a subset
 * objects.json and its translations are validated here (bad data fails the build); the layout is computed at build
 * time; texts follow the page's language.
 */
import ObjectGraphView from './ObjectGraphView.tsx';
import { NOTE_OVERLAYS, OBJECTS, labelOf, noteOf, obj, objectErrors, overlayErrors } from '../lib/objects';
import { courseText } from '../i18n';
import { canvasHeight, layout } from 'course-kit/lib/layout.ts';
import { graphIn } from 'course-kit/lib/terms.ts';
import { DEFAULT_LANG, LANGUAGES, courseIn, langOf } from 'course-kit/lib/course.ts';
import { fmt } from 'course-kit/i18n.mjs';

interface Props {
	mode?: 'map' | 'build';
	/** Object ids to show (default: all). Parents outside the scope are left out of the picture. */
	scope?: string[];
	caption?: string;
}

const v = courseIn(langOf(Astro.url.pathname));
const t = courseText(v.lang);
// Every course language other than the default needs a complete translation of the object notes.
const missingLangs = LANGUAGES.slice(1).filter((l) => !(l.code in NOTE_OVERLAYS)).map((l) => `objects.${l.code}.json`);
const errs = [...objectErrors(new Set(graphIn(DEFAULT_LANG).terms.map((x) => x.id))), ...overlayErrors(), ...missingLangs.map((f) => `${f} is missing`)];
if (errs.length) throw new Error(`objects data is invalid:\n  - ${errs.join('\n  - ')}`);

const { mode = 'map', caption } = Astro.props;
const scope = Astro.props.scope ?? OBJECTS.map((o) => o.id);
scope.forEach((id) => obj(id));
const inScope = new Set(scope);

// Parent -> child, so creation flows top to bottom and the instance sits at the top.
const edges = scope.flatMap((id) => obj(id).parents.filter((p) => inScope.has(p.id)).map((p) => ({ from: p.id, to: id, optional: p.optional === true })));
// The device parents most objects; in one rank they would make the map too wide to read. Objects of the later
// stages hang one rank lower, which turns one long row into two shorter ones.
const LOWER = new Set(['memory', 'images', 'descriptors', 'pipeline']);
// Left to right inside a row: the order of objects.json, which follows the course.
const order = new Map(OBJECTS.map((o, i) => [o.id, i]));
const placed = layout({
	nodes: scope.map((id) => ({ id, label: labelOf(obj(id)), order: order.get(id) })),
	links: edges.map((e) => ({
		source: e.from,
		target: e.to,
		minlen: e.from === 'device' && LOWER.has(obj(e.to).stage) ? 2 : 1,
	})),
});
const nodes = placed.nodes;
const height = canvasHeight({ width: Math.max(...nodes.map((n) => n.x + n.w)), height: placed.height });
const termHref = Object.fromEntries(scope.flatMap((id) => (obj(id).term ? [[obj(id).term!, v.resolveLink(`term:${obj(id).term}`)!]] : [])));
---

<figure class="vk-objgraph not-content">
	<div style={`min-height:${height + (mode === 'build' ? 330 : 140)}px`}>
		<ObjectGraphView client:only="react" lang={v.lang} defaultLang={DEFAULT_LANG} mode={mode} nodes={nodes} edges={edges} height={height} termHref={termHref} />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
	<details class="vk-objgraph-text">
		<summary>{t.asText}</summary>
		<ul>
			{
				scope.map((id) => {
					const o = obj(id);
					return (
						<li>
							<b>{labelOf(o)}</b> — {o.call}
							{o.parents.length > 0 && `, ${fmt(t.madeFrom, { parents: o.parents.map((p) => labelOf(obj(p.id))).join(' + ') })}`}
							{o.destroy && `; ${fmt(t.releasedWith, { call: o.destroy })}`}. {noteOf(o, v.lang, DEFAULT_LANG)}
						</li>
					);
				})
			}
		</ul>
	</details>
</figure>

<style>
	.vk-objgraph {
		margin: 1.5rem 0;
	}
	figcaption,
	.vk-objgraph-text summary {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.vk-objgraph-text {
		font-size: var(--sl-text-sm);
	}
	.vk-objgraph-text summary {
		cursor: pointer;
	}
</style>
