---
/**
 * Screenshots of the example programs (src/assets/: copies of examples/screenshots/ and *_zoom.png crops of them), one
 * or several side by side, each with a caption. Lessons quote measured pixel values of these images, so they are served as PNG: the default
 * WebP re-encode would change the pixels the captions describe. Pairs (with/without a feature) sit next to each other
 * on wide screens and stack on narrow ones.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Shot {
	src: ImageMetadata;
	alt: string;
	caption: string;
	/** An enlarged crop: keep its pixels square when the browser scales it, or the staircases it shows get smoothed. */
	zoom?: boolean;
}
interface Props {
	shots: Shot[];
}

const { shots } = Astro.props;
---

<div class="shots">
	{
		shots.map((s) => (
			<figure>
				<Image src={s.src} format="png" alt={s.alt} class:list={{ zoom: s.zoom }} />
				<figcaption>{s.caption}</figcaption>
			</figure>
		))
	}
</div>

<style>
	.shots {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
		margin-block: 1.5rem;
	}
	figure {
		margin: 0;
	}
	figure :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	figure :global(img.zoom) {
		image-rendering: pixelated;
	}
	figcaption {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
</style>
