---
/**
 * Command-path lab: CPU records and submits, the GPU executes later; the reader picks when the CPU waits on the
 * fence (CommandPathView island). The no-JS fallback lists both schedules as text from the same model.
 */
import CommandPathView from './CommandPathView.tsx';
import { FRAMES, percent, simulate, type InFlight } from '../../lib/labs/command-path';
import { pick } from '../../lib/text';
import { TEXT } from './command-path.text';
import { courseIn, langOf } from 'course-kit/lib/course.ts';
import { fmt } from 'course-kit/i18n.mjs';

const v = courseIn(langOf(Astro.url.pathname));
const t = pick(TEXT, v.lang, 'command-path');
const modes: InFlight[] = [1, 2];
const rows = modes.map((m) => {
	const s = simulate(m);
	const span = (f: number, kind: string) => s.segments.find((x) => x.f === f && x.kind === kind)!;
	return {
		head: fmt(t.fbRow, { mode: m === 1 ? t.mode1 : t.mode2, n: FRAMES, t: s.end, gpu: percent(s, ['exec']), wait: percent(s, ['wait']) }),
		frames: Array.from({ length: FRAMES }, (_, f) =>
			fmt(t.fbFrame, { f: f + 1, r0: span(f, 'record').t0, r1: span(f, 'record').t1, q: span(f, 'submit').t1, g0: span(f, 'exec').t0, g1: span(f, 'exec').t1 }),
		),
	};
});
---

<figure class="vk-lab not-content">
	<div class="vk-lab-slot">
		<CommandPathView client:only="react" lang={v.lang} />
	</div>
	<details class="vk-lab-text">
		<summary>{t.asText}</summary>
		{
			rows.map((r) => (
				<>
					<p>{r.head}</p>
					<ul>
						{r.frames.map((x) => (
							<li>{x}</li>
						))}
					</ul>
				</>
			))
		}
		<p>{t.illustrative}</p>
	</details>
</figure>

<style>
	.vk-lab {
		margin: 1.5rem 0;
	}
	/* Reserves the island's height so the page does not jump when it mounts. */
	.vk-lab-slot {
		min-height: 34rem;
	}
	.vk-lab-text {
		font-size: var(--sl-text-sm);
	}
	.vk-lab-text summary {
		cursor: pointer;
		color: var(--sl-color-gray-3);
	}
</style>
