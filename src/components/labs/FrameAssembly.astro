---
/**
 * Frame assembly trainer: <FrameAssembly />. Renders the FrameAssemblyView island in the page's language with the
 * rules version (a hash of the model and the scenario: a change makes stored runs start fresh; texts do not count). Without
 * JavaScript the reader gets one correct frame of step 10 as text.
 */
import FrameAssemblyView from './FrameAssemblyView.tsx';
import { courseIn, langOf } from 'course-kit/lib/course.ts';
import { textErrors } from '../../lib/text';
import { ruleVersion } from '../../lib/object-trainer';
import { textOf } from '../../lib/frame-trainer';
import { TEXT } from './frame-assembly.text';
// Raw sources of the rules (build time only): their hash is the version stored runs are tagged with.
import modelCode from '../../lib/frames.ts?raw';
import trainerCode from '../../lib/frame-trainer.ts?raw';

const errs = textErrors(TEXT, 'frame-assembly');
if (errs.length) throw new Error(`frame-assembly texts are invalid:\n  - ${errs.join('\n  - ')}`);

const { lang } = courseIn(langOf(Astro.url.pathname));
const t = textOf(lang);
const version = ruleVersion([modelCode, trainerCode]);
const steps = [t.fb_1, t.fb_2, t.fb_3, t.fb_4, t.fb_5, t.fb_6];
---

<figure class="vk-frame-assembly not-content">
	<FrameAssemblyView client:only="react" lang={lang} version={version} />
	<details class="vk-frame-assembly-text">
		<summary>{t.asText}</summary>
		<p>{t.fb_intro}</p>
		<ol>{steps.map((s) => <li>{s}</li>)}</ol>
	</details>
</figure>

<style>
	.vk-frame-assembly {
		margin: 1.5rem 0;
		min-height: 10rem;
	}
	.vk-frame-assembly-text {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
	}
	.vk-frame-assembly-text summary {
		cursor: pointer;
		color: var(--sl-color-gray-3);
	}
</style>
