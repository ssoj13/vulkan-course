---
/**
 * GL-vs-Vulkan lab: the same frame on a GL-style driver (variants compiled at draw time) and on Vulkan (pipelines
 * created at load), GlVsVulkanView island. The no-JS fallback states the result for the starting scene and lists the
 * core dynamic states, from the same model and data.
 */
import GlVsVulkanView from './GlVsVulkanView.tsx';
import { DEPTH_DYNAMIC, DYNAMIC_STATES, SCENE, dynamicByVersion, simulate } from '../../lib/labs/gl-vs-vulkan';
import { pick } from '../../lib/text';
import { TEXT } from './gl-vs-vulkan.text';
import { courseIn, langOf } from 'course-kit/lib/course.ts';
import { fmt } from 'course-kit/i18n.mjs';

// The lab's depth toggle names a dynamic state; it must be core, or the lab would teach something false.
if (!DYNAMIC_STATES.some((s) => s.name === DEPTH_DYNAMIC)) throw new Error(`gl-vs-vulkan: ${DEPTH_DYNAMIC} is not in dynamic-states.json`);

const v = courseIn(langOf(Astro.url.pathname));
const t = pick(TEXT, v.lang, 'gl-vs-vulkan');
const r = simulate(SCENE, true);
---

<figure class="vk-lab not-content">
	<div class="vk-lab-slot">
		<GlVsVulkanView client:only="react" lang={v.lang} />
	</div>
	<details class="vk-lab-text">
		<summary>{t.asText}</summary>
		<p>{fmt(t.fbGl, { programs: r.programs.length, n: r.glFrameCompiles })}</p>
		<p>{fmt(t.fbVk, { pipelines: r.pipelines.length })}</p>
		<p>{t.model}</p>
		<p>{t.dynTitle}:</p>
		<ul>
			{
				dynamicByVersion().map(([ver, names]) => (
					<li>
						{fmt(t.dynSince, { v: ver })}: <code>{names.join(', ')}</code>
					</li>
				))
			}
		</ul>
	</details>
</figure>

<style>
	.vk-lab {
		margin: 1.5rem 0;
	}
	/* Reserves the island's height so the page does not jump when it mounts. */
	.vk-lab-slot {
		min-height: 52rem;
	}
	.vk-lab-text {
		font-size: var(--sl-text-sm);
	}
	.vk-lab-text summary {
		cursor: pointer;
		color: var(--sl-color-gray-3);
	}
</style>
